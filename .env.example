APP_NAME="SIMRS Khanza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simrs_khanza
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Configuration (Redis recommended for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cache Configuration (Redis for high performance)
CACHE_STORE=redis
CACHE_PREFIX=simrs_cache

MEMCACHED_HOST=127.0.0.1

# Redis Configuration (Required for cache and queue)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@simrs.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Configuration (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO Configuration (S3-compatible on-premise storage)
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=simrs
MINIO_ENDPOINT=http://localhost:9000

# DICOM Storage Driver (local or s3 or minio)
DICOM_STORAGE_DRIVER=local

# BPJS VClaim API Configuration
BPJS_ENV=development
BPJS_BASE_URL=https://apijkndev.bpjs-kesehatan.go.id
BPJS_CONS_ID=
BPJS_SECRET_KEY=
BPJS_USER_KEY=
BPJS_TIMEOUT=10
BPJS_RETRY_TIMES=3
BPJS_RETRY_DELAY=1000
BPJS_PPK_CODE=
BPJS_PCARE_USERNAME=
BPJS_PCARE_PASSWORD=
BPJS_CACHE_DURATION=86400

# SATUSEHAT (Ministry of Health) Configuration
SATUSEHAT_ENV=development
SATUSEHAT_BASE_URL=https://api-satusehat-dev.dto.kemkes.go.id
SATUSEHAT_AUTH_URL=https://api-satusehat-dev.dto.kemkes.go.id/oauth2/v1/accesstoken
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=
SATUSEHAT_TIMEOUT=15
SATUSEHAT_RETRY_TIMES=3
SATUSEHAT_RETRY_DELAY=2000
SATUSEHAT_AUTO_SUBMIT=false
SATUSEHAT_SUBMISSION_QUEUE=high
SATUSEHAT_BATCH_SIZE=50
SATUSEHAT_TOKEN_CACHE=3600
SATUSEHAT_LOG_REQUESTS=true
SATUSEHAT_LOG_RESPONSES=true

# Sentry Error Tracking (Production monitoring)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Laravel Telescope (Development monitoring - disable in production)
TELESCOPE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
